# SysMho — Environment Variables
# Copy this file to .env and fill in your values.

# ── Binance API (REQUIRED) ────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=True

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sysmho

# ── Engine Behavior ───────────────────────────────────────────────────────────
AUTONOMOUS_MODE=false
LEARNING_LOOP_SECONDS=60

# ── Dashboard Security ────────────────────────────────────────────────────────
# Leave empty to disable API key protection (open access).
DASHBOARD_API_KEY=

# ── MetaEvaluator Thresholds ──────────────────────────────────────────────────
META_SCORE_THRESHOLD=0.52
META_MIN_TRADES=10
META_MIN_FOR_MODEL=200

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CB_MAX_POSITIONS=3
CB_MAX_DAILY_TRADES=8
CB_MAX_CONSEC_LOSSES=3
CB_DAILY_LOSS_PCT=0.04
CB_WEEKLY_DRAWDOWN_PCT=0.08
